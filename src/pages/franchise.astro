<script>
  document.addEventListener('DOMContentLoaded', () => {
    const STORAGE_KEY = 'cotto_franchise_applications';
    const form = document.getElementById('cotto-franchise-form') as HTMLFormElement | null;
    const successBox = document.getElementById('franchise-form-success');
    const trackingEl = document.getElementById('franchise-tracking-code');
    const waFollowup = document.getElementById('franchise-whatsapp-followup') as HTMLAnchorElement | null;
    const conceptSelect = document.getElementById('form-concept-select') as HTMLSelectElement | null;

    // Concept card quick selection buttons
    document.querySelectorAll('.select-concept-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const modelId = btn.getAttribute('data-select-concept');
        if (!conceptSelect) return;
        if (modelId === 'cotto-express') conceptSelect.selectedIndex = 1;
        if (modelId === 'cotto-bistro') conceptSelect.selectedIndex = 0;
        if (modelId === 'cotto-gastro-lounge') conceptSelect.selectedIndex = 2;
      });
    });

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const code = `FR-COTTO-${Math.floor(1000 + Math.random() * 9000)}`;

        const newApp = {
          id: code,
          fullName: String(fd.get('fullName') || ''),
          phone: String(fd.get('phone') || ''),
          email: String(fd.get('email') || ''),
          city: String(fd.get('city') || ''),
          conceptModel: String(fd.get('conceptModel') || 'Cotto Bistro & Pizzeria'),
          budget: String(fd.get('budget') || ''),
          hasLocation: String(fd.get('hasLocation') || ''),
          experience: String(fd.get('experience') || ''),
          notes: String(fd.get('notes') || ''),
          status: 'Yeni Başvuru',
          createdAt: new Date().toISOString()
        };

        try {
          const existing = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          existing.unshift(newApp);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(existing));
        } catch (err) {
          console.error(err);
        }

        if (trackingEl) trackingEl.textContent = `#${code}`;
        if (waFollowup) {
          const msg = `Merhaba Cotto Napoliten Franchise Direktörlüğü, #${code} takip numarasıyla ${newApp.city} (${newApp.conceptModel}) için yatırımcı başvurusu yaptım. İsim: ${newApp.fullName}`;
          waFollowup.href = `https://wa.me/905458344090?text=${encodeURIComponent(msg)}`;
        }
        if (successBox) successBox.classList.remove('hidden');
        form.reset();
      });
    }
  });
</script>
