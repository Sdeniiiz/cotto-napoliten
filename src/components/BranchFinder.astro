---
// src/components/BranchFinder.astro
// Clean branch showcase cards without stacked button clutter
import { branches } from '../data/branches';
---

<section id="subeler" class="py-16 sm:py-24 bg-white border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#D9381E] mb-2">
          MERKEZ & BÜYÜME AĞIMIZ
        </p>
        <h2 class="text-3xl sm:text-4xl font-black text-[#141210] tracking-tight uppercase">
          Cotto Napoliten Lokasyonları
        </h2>
      </div>
      <a href="/subeler" class="text-xs font-extrabold uppercase tracking-wider text-[#D9381E] hover:underline">
        Tüm Şube ve Haritaları Gör →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {branches.map((branch) => (
        <a
          href={`/subeler/${branch.slug}`}
          class="group bg-[#F6F3EE] rounded-3xl overflow-hidden border border-stone-200/90 hover:border-[#D9381E] transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="relative aspect-[16/9] overflow-hidden bg-stone-900">
              <img
                src={branch.image}
                alt={branch.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-5 right-5 text-white">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#E59838] block">
                  {branch.city} / {branch.district}
                </span>
                <h3 class="text-lg font-black tracking-tight">
                  {branch.name}
                </h3>
              </div>
            </div>

            <div class="p-6 space-y-2 text-xs sm:text-sm text-stone-600">
              <p class="line-clamp-2">{branch.address}</p>
              <p class="font-mono font-bold text-[#141210]">
                {branch.workingHours.weekdays} • {branch.phoneDisplay}
              </p>
            </div>
          </div>

          <div class="px-6 py-4 border-t border-stone-200/80 flex items-center justify-between text-xs font-extrabold text-[#D9381E]">
            <span>Şube Bilgisi & Konum</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
