---
// src/components/branches/BranchHero.astro
import type { BranchAggregate } from '../../types/branch';

interface Props {
  branch: BranchAggregate;
}

const { branch } = Astro.props;
const isActive = branch.entity?.status === 'active';
const hoursText = branch.workingHours?.weekdays || branch.hours?.weekdays || '11:00 - 23:30';
const ysUrl = branch.orderSettings?.externalDeliveryPartners?.yemeksepetiUrl || 'https://www.yemeksepeti.com/restaurant/xiok/cotto-cafe-and-restoran-xiok';
---

<section class="relative py-16 md:py-24 bg-[#141210] text-white overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img
      src={branch.branding?.heroImage?.desktop || branch.image || '/images/cotto/mekan-ic-salon.jpg'}
      alt={branch.name}
      class="w-full h-full object-cover opacity-35"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#141210] via-[#141210]/80 to-[#141210]/60"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-wrap items-center gap-3 mb-3 text-xs font-bold uppercase tracking-widest">
      <a href="/subeler" class="text-white/70 hover:text-[#E59838] transition-colors">
        ← Tüm Şubeler
      </a>
      <span class="text-white/30">•</span>
      <span class="text-[#E59838]">
        {branch.city} / {branch.district}
      </span>
      <span class="text-white/30">•</span>
      <span class={isActive ? 'text-emerald-400' : 'text-amber-300'}>
        {isActive ? `Aktif Şube (${hoursText})` : 'Franchise Tahsise Açık'}
      </span>
    </div>

    <h1 class="text-3xl sm:text-5xl md:text-6xl font-black uppercase tracking-tight mb-4">
      {branch.name}
    </h1>

    <p class="text-white/80 text-base sm:text-lg max-w-2xl font-light leading-relaxed mb-6">
      {branch.info?.description || branch.hero?.subline || branch.workingHours?.note}
    </p>

    <div class="flex flex-wrap items-center gap-6">
      <a
        href="/franchise"
        class="text-sm font-extrabold text-[#E59838] hover:text-white underline underline-offset-4 transition-colors"
      >
        Bu Konseptin Franchise Bilgisi →
      </a>
      <a
        href={ysUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-bold text-white/85 hover:text-[#E59838] transition-colors"
      >
        Yemeksepeti Mağazası ↗
      </a>
    </div>
  </div>
</section>
