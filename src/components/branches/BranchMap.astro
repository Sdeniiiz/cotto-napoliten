---
// src/components/branches/BranchMap.astro
import type { BranchAggregate } from '../../types/branch';

interface Props {
  branch: BranchAggregate;
}

const { branch } = Astro.props;
const mapQuery = encodeURIComponent(`${branch.name} ${branch.address}`);
---

<div class="bg-white rounded-3xl p-4 sm:p-6 border border-stone-200/80 shadow-sm">
  <div class="flex items-center justify-between mb-4">
    <div>
      <span class="text-[11px] font-extrabold uppercase tracking-widest text-cotto-red block">KONUM & YOL TARİFİ</span>
      <h3 class="text-lg font-serif font-bold text-cotto-dark">{branch.district}, {branch.city}</h3>
    </div>
    {branch.googleMapsUrl && (
      <a
        href={branch.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-xl bg-cotto-dark hover:bg-cotto-red text-white text-xs font-bold transition-colors"
      >
        Haritada Aç ↗
      </a>
    )}
  </div>

  <div class="aspect-video w-full rounded-2xl overflow-hidden bg-stone-100 border border-stone-200">
    <iframe
      title={`${branch.name} Harita`}
      width="100%"
      height="100%"
      style="border:0"
      loading="lazy"
      allowfullscreen
      referrerpolicy="no-referrer-when-downgrade"
      src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
    ></iframe>
  </div>
</div>
