---
// src/components/branches/BranchInfo.astro
import type { BranchAggregate } from '../../types/branch';

interface Props {
  branch: BranchAggregate;
}

const { branch } = Astro.props;
---

<div class="bg-white rounded-3xl p-6 sm:p-8 border border-stone-200/80 shadow-sm space-y-6">
  <div>
    <span class="text-[11px] font-extrabold uppercase tracking-widest text-cotto-red block mb-1">ŞUBE DETAYLARI</span>
    <h2 class="text-2xl font-serif font-extrabold text-cotto-dark">İletişim & Çalışma Saatleri</h2>
  </div>

  <div class="space-y-4 text-sm">
    <div class="flex items-start gap-3.5">
      <div class="w-10 h-10 rounded-xl bg-cotto-red/10 text-cotto-red flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
      </div>
      <div>
        <div class="font-bold text-cotto-dark">Adres</div>
        <div class="text-cotto-muted leading-relaxed">{branch.address}</div>
      </div>
    </div>

    <div class="flex items-start gap-3.5">
      <div class="w-10 h-10 rounded-xl bg-cotto-red/10 text-cotto-red flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <div>
        <div class="font-bold text-cotto-dark">Çalışma Saatleri</div>
        <div class="text-cotto-muted">Hafta İçi: {branch.workingHours.weekdays} • Hafta Sonu: {branch.workingHours.weekend}</div>
      </div>
    </div>

    <div class="flex items-start gap-3.5">
      <div class="w-10 h-10 rounded-xl bg-cotto-red/10 text-cotto-red flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
      </div>
      <div>
        <div class="font-bold text-cotto-dark">Telefon & Paket Servis</div>
        <a href={`tel:${branch.phone}`} class="text-cotto-red font-bold hover:underline">{branch.phoneDisplay || branch.phone}</a>
      </div>
    </div>
  </div>

  {branch.highlights && branch.highlights.length > 0 && (
    <div class="pt-4 border-t border-stone-100">
      <span class="text-xs font-bold uppercase tracking-wider text-stone-400 block mb-3">Şube Özellikleri</span>
      <div class="flex flex-wrap gap-2">
        {branch.highlights.map((feat) => (
          <span class="text-xs font-bold bg-stone-100 text-cotto-dark px-3 py-1.5 rounded-xl">
            ✓ {feat}
          </span>
        ))}
      </div>
    </div>
  )}
</div>
