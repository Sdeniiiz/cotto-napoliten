---
// src/components/MenuSection.astro
// Clean Domino's TR Style 4-Column Product Grid using Real Cotto Napoliten Photos
// ZERO buttons inside product cards — entire card is clickable, clean price & info
import { menuItems } from '../data/menu';
import { categories } from '../data/categories';
---

<section id="menu" class="py-16 sm:py-24 bg-[#F6F3EE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header + Clean Category Tabs -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 border-b border-stone-200 pb-6">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#D9381E] mb-2">
          COTTO NAPOLİTEN LEZZET KATALOĞU
        </p>
        <h2 class="text-3xl sm:text-4xl font-black text-[#141210] uppercase tracking-tight">
          Napoliten Pizzalarımız & Gurme Burgerlerimiz
        </h2>
      </div>

      <!-- Clean Text/Tab Filter Bar -->
      <div class="flex items-center gap-6 overflow-x-auto no-scrollbar" id="home-category-tabs">
        <button
          type="button"
          data-cat-filter="all"
          class="home-cat-btn pb-2 text-sm font-black uppercase tracking-wider transition-all cursor-pointer text-[#D9381E] border-b-2 border-[#D9381E] shrink-0"
        >
          Tüm Menü ({menuItems.length})
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            data-cat-filter={cat.id}
            class="home-cat-btn pb-2 text-sm font-bold uppercase tracking-wider transition-all cursor-pointer text-stone-500 hover:text-[#141210] border-b-2 border-transparent shrink-0"
          >
            {cat.name}
          </button>
        ))}
      </div>
    </div>

    <!-- 4-Column Clean Product Showcase Grid (No Buttons Inside Cards) -->
    <div id="home-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {menuItems.map((item) => (
        <a
          href={`/menu/${item.slug}`}
          data-item-cat={item.category}
          class="home-menu-card group bg-white rounded-2xl overflow-hidden border border-stone-200/90 hover:border-[#D9381E] shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <!-- Product Photo -->
            <div class="relative aspect-[4/3] w-full overflow-hidden bg-stone-100">
              <img
                src={item.image}
                alt={item.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>

            <!-- Card Text -->
            <div class="p-5">
              <div class="text-[10px] font-bold uppercase tracking-widest text-stone-400 mb-1">
                {item.categoryName}
              </div>
              <h3 class="font-black text-lg text-[#141210] group-hover:text-[#D9381E] transition-colors leading-snug mb-1.5">
                {item.name}
              </h3>
              <p class="text-xs text-stone-600 line-clamp-2 leading-relaxed">
                {item.shortDescription}
              </p>
            </div>
          </div>

          <!-- Clean Price & Spec Footer (No Buttons) -->
          <div class="px-5 pb-4 pt-3 border-t border-stone-100 flex items-center justify-between">
            <span class="font-mono font-black text-lg text-[#D9381E]">{item.price} ₺</span>
            <span class="text-[11px] font-semibold text-stone-400 group-hover:text-[#141210] transition-colors">
              İçeriği Gör →
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Single Clean Yemeksepeti & Menu Footer Note -->
    <div class="mt-10 pt-6 border-t border-stone-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-stone-600">
      <p>
        Tüm ürünlerimiz sipariş anında <strong>450°C özel Napoliten kubbe fırınımızda</strong> taze olarak hazırlanmaktadır.
      </p>
      <a
        href="https://www.yemeksepeti.com/restaurant/xiok/cotto-cafe-and-restoran-xiok"
        target="_blank"
        rel="noopener noreferrer"
        class="font-extrabold text-[#D9381E] hover:underline shrink-0"
      >
        Paket servis için Yemeksepeti mağazamızı ziyaret edin ↗
      </a>
    </div>

  </div>
</section>

<script>
  function setupCategoryFiltering() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.home-cat-btn');
    const cards = document.querySelectorAll<HTMLElement>('.home-menu-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-cat-filter');

        tabs.forEach((t) => {
          t.classList.remove('text-[#D9381E]', 'border-[#D9381E]', 'font-black');
          t.classList.add('text-stone-500', 'border-transparent', 'font-bold');
        });
        tab.classList.remove('text-stone-500', 'border-transparent', 'font-bold');
        tab.classList.add('text-[#D9381E]', 'border-[#D9381E]', 'font-black');

        cards.forEach((card) => {
          const itemCat = card.getAttribute('data-item-cat');
          if (filter === 'all' || itemCat === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCategoryFiltering);
  } else {
    setupCategoryFiltering();
  }
</script>
