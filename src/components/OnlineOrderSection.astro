---
// src/components/OnlineOrderSection.astro
// Domino's Style Dual Banner: Franchise Investor Callout + Yemeksepeti Official Partner Link
---

<section class="py-12 md:py-16 bg-[#F4EFEA]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">

      <!-- Left (7 Cols): Franchise Growth Banner -->
      <a
        href="/franchise"
        class="group lg:col-span-7 bg-[#141210] text-white rounded-3xl p-7 sm:p-10 border border-[#E59838]/30 hover:border-[#E59838] shadow-xl flex flex-col justify-between relative overflow-hidden transition-all"
      >
        <div class="space-y-3 relative z-10">
          <p class="text-[#E59838] text-xs font-extrabold uppercase tracking-[0.2em]">
            TÜRKİYE GENELİ FRANCHISE BÜYÜME AĞI
          </p>
          <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight leading-tight">
            Kendi Şehrinizde <span class="text-[#E59838]">Cotto Napoliten</span> Yatırımcısı Olun
          </h2>
          <p class="text-stone-300 text-sm sm:text-base leading-relaxed max-w-xl">
            Usta kaprisini bitiren <strong>450°C Fornero Döner Özel Napoliten Fırın</strong> teknolojisi, merkezi soğuk fermantasyon reçetesi ve anahtar teslim kurulum desteğiyle karlı bir yatırıma adım atın.
          </p>
        </div>

        <div class="pt-6 mt-6 border-t border-white/10 flex items-center justify-between relative z-10">
          <span class="text-xs font-mono text-stone-400">Express • Bistro • Gastro Lounge</span>
          <span class="text-sm font-extrabold text-[#E59838] group-hover:translate-x-1 transition-transform">
            Franchise Dosyasını & Simülatörü İncele →
          </span>
        </div>
      </a>

      <!-- Right (5 Cols): Official Yemeksepeti Store Card -->
      <a
        href="https://www.yemeksepeti.com/restaurant/xiok/cotto-cafe-and-restoran-xiok"
        target="_blank"
        rel="noopener noreferrer"
        class="group lg:col-span-5 bg-[#D9381E] text-white rounded-3xl p-7 sm:p-10 border border-[#b82810] shadow-xl flex flex-col justify-between relative overflow-hidden transition-all"
      >
        <div class="space-y-3 relative z-10">
          <p class="text-amber-200 text-xs font-extrabold uppercase tracking-[0.2em]">
            RESMİ PAKET SERVİS PARTNERİMİZ
          </p>
          <h3 class="text-2xl sm:text-3xl font-black uppercase tracking-tight leading-tight">
            Özel Napoliten Fırın Lezzetlerimiz Yemeksepeti'nde
          </h3>
          <p class="text-white/90 text-sm leading-relaxed">
            Buhar tahliyeli özel Cotto Termal Kutu teknolojimizle sıcak Napoliten pizzalarımız ve gurme burgerlerimiz için resmi Yemeksepeti mağazamızı ziyaret edebilirsiniz.
          </p>
        </div>

        <div class="pt-6 mt-6 border-t border-white/20 flex items-center justify-between gap-4 relative z-10">
          <div>
            <div class="text-amber-200 text-xs font-bold">Cotto Cafe & Restoran (Çarşamba)</div>
          </div>
          <span class="text-sm font-extrabold text-white underline underline-offset-4 group-hover:translate-x-0.5 transition-transform">
            Yemeksepeti'ne Git ↗
          </span>
        </div>
      </a>

    </div>
  </div>
</section>
